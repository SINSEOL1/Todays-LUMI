<Window x:Class="TodaysLUMI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="오늘의 루미"
        Width="780"
        Height="580"
        MinWidth="780"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30"
                            Height="30"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="8">
                        <TextBlock Text="L"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <TextBlock Text="오늘의 루미"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="9,4"
                        Background="#F4F6F8"
                        CornerRadius="6">
                    <TextBlock x:Name="VersionText"
                               Text="1.0.0"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="174"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="12,18,12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button x:Name="HomeNavButton"
                                Content="홈"
                                Tag="Active"
                                Style="{StaticResource NavButtonStyle}"
                                Click="HomeNavButton_Click"/>
                        <Button x:Name="OverlayNavButton"
                                Content="오버레이"
                                Style="{StaticResource NavButtonStyle}"
                                Click="OverlayNavButton_Click"/>
                        <Button x:Name="SettingsNavButton"
                                Content="설정"
                                Style="{StaticResource NavButtonStyle}"
                                Click="SettingsNavButton_Click"/>
                        <Button x:Name="AboutNavButton"
                                Content="정보"
                                Style="{StaticResource NavButtonStyle}"
                                Click="AboutNavButton_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="14,0,10,4">
                        <TextBlock Text="개발자 문의"
                                   FontSize="10"
                                   Foreground="#929BA5"/>
                        <TextBlock Text="Discord · sinseol"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="HomePage" Margin="30,26">
                    <StackPanel>
                        <TextBlock Text="홈" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="게임 상태와 이번 게임의 LUMI 정보를 확인합니다."
                                   Style="{StaticResource PageSubtitleStyle}"/>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="게임 연결"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Ellipse x:Name="GameStatusDot"
                                                 Width="9"
                                                 Height="9"
                                                 Fill="#929AA3"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock x:Name="GameStatusText"
                                                   Text="게임을 기다리는 중"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock x:Name="GameStatusDescription"
                                               Text="이터널 리턴이 실행되면 자동으로 연결합니다."
                                               Margin="0,7,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="CurrentItemAccentBar"
                                            Grid.Column="0"
                                            Background="#D4D9DF"
                                            CornerRadius="2"/>

                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                        <TextBlock Text="이번 게임"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="CurrentItemText"
                                                   Text="아직 감지되지 않음"
                                                   Margin="0,7,0,0"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="LUMI 판매 아이템"
                                                   Margin="0,5,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="오버레이"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock x:Name="OverlayRuntimeStatusText"
                                                   Text="표시 대기"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text=" · "
                                                   FontSize="12"
                                                   Foreground="#A0A7AF"/>
                                        <TextBlock Text="표시/숨김 단축키 "
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="HomeHotkeyText"
                                                   Text="Ctrl + Shift + L"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="다시 인식"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RecognizeNowButton_Click"/>
                                    <Button Content="오버레이 테스트"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="OverlayTestButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="OverlayPage"
                      Visibility="Collapsed"
                      Margin="30,26">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,18">
                            <TextBlock Text="오버레이" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="게임 화면에 표시되는 정보와 단축키를 설정합니다."
                                       Style="{StaticResource PageSubtitleStyle}"/>

                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="표시 설정" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock x:Name="OverlayPageRuntimeStatusText"
                                                       Text="표시 대기"
                                                       HorizontalAlignment="Right"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </Grid>

                                        <CheckBox x:Name="OverlayEnabledCheckBox"
                                                  Content="오버레이 사용"
                                                  Margin="0,17,0,0"
                                                  IsChecked="True"
                                                  Style="{StaticResource SwitchStyle}"
                                                  Checked="OverlaySetting_Changed"
                                                  Unchecked="OverlaySetting_Changed"/>

                                        <Border Height="1" Margin="0,13" Background="#EEF0F3"/>

                                        <CheckBox x:Name="CompactOverlayCheckBox"
                                                  Content="컴팩트하게 표시"
                                                  Style="{StaticResource SwitchStyle}"
                                                  Checked="OverlaySetting_Changed"
                                                  Unchecked="OverlaySetting_Changed"/>

                                        <Border Height="1" Margin="0,13" Background="#EEF0F3"/>

                                        <CheckBox x:Name="GameActiveOnlyCheckBox"
                                                  Content="게임이 실행 중일 때만 표시"
                                                  IsChecked="True"
                                                  Style="{StaticResource SwitchStyle}"
                                                  Checked="OverlaySetting_Changed"
                                                  Unchecked="OverlaySetting_Changed"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="크기와 투명도"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <Grid Margin="0,15,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="크기"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Slider x:Name="OverlayScaleSlider"
                                                    Grid.Column="1"
                                                    Margin="12,0"
                                                    Minimum="0.75"
                                                    Maximum="1.50"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="OverlayScaleSlider_ValueChanged"/>
                                            <TextBlock x:Name="OverlayScaleValueText"
                                                       Grid.Column="2"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="100%"/>
                                        </Grid>

                                        <Grid Margin="0,15,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="투명도"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Slider x:Name="OverlayOpacitySlider"
                                                    Grid.Column="1"
                                                    Margin="12,0"
                                                    Minimum="0.50"
                                                    Maximum="1.00"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="OverlayOpacitySlider_ValueChanged"/>
                                            <TextBlock x:Name="OverlayOpacityValueText"
                                                       Grid.Column="2"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="92%"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="오버레이 위치"
                                                   Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock x:Name="OverlayPositionStatusText"
                                                   Text="게임 화면 기준으로 위치가 저장됩니다."
                                                   Margin="0,6,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="기본 위치"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="ResetOverlayPositionButton_Click"/>
                                        <Button x:Name="OverlayPositionButton"
                                                Content="위치 조정"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="OverlayPositionButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="표시/숨김 단축키"
                                                   Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="게임 중에도 이 단축키로 오버레이를 바로 숨기거나 다시 표시할 수 있습니다."
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                            <Border Padding="11,7"
                                                    Background="#F2F4F7"
                                                    BorderBrush="#DFE3E8"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <TextBlock x:Name="HotkeyDisplayText"
                                                           Text="Ctrl + Shift + L"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                            <Button x:Name="HotkeyCaptureButton"
                                                    Content="변경"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="HotkeyCaptureButton_Click"/>
                                        </StackPanel>

                                        <TextBlock x:Name="HotkeyStatusText"
                                                   Margin="0,7,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="미리보기"
                                                   Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="표시할 아이템을 선택해 오버레이를 확인합니다."
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="TestItemComboBox"
                                                  Margin="0,14,0,0"
                                                  Height="30"
                                                  SelectionChanged="TestItemComboBox_SelectionChanged"/>
                                        <Button Content="테스트"
                                                Margin="0,10,0,0"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="OverlayTestButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="SettingsPage"
                      Visibility="Collapsed"
                      Margin="30,26">
                    <StackPanel>
                        <TextBlock Text="설정" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="프로그램 실행과 인식 동작을 설정합니다."
                                   Style="{StaticResource PageSubtitleStyle}"/>

                        <Border Margin="0,22,0,0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="일반" Style="{StaticResource SectionTitleStyle}"/>

                                <CheckBox x:Name="StartWithWindowsCheckBox"
                                          Content="Windows 시작 시 실행"
                                          Margin="0,17,0,0"
                                          Style="{StaticResource SwitchStyle}"
                                          Checked="GeneralSetting_Changed"
                                          Unchecked="GeneralSetting_Changed"/>

                                <Border Height="1" Margin="0,13" Background="#EEF0F3"/>

                                <CheckBox x:Name="CloseToTrayCheckBox"
                                          Content="창을 닫으면 트레이로 최소화"
                                          IsChecked="True"
                                          Style="{StaticResource SwitchStyle}"
                                          Checked="GeneralSetting_Changed"
                                          Unchecked="GeneralSetting_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="동작" Style="{StaticResource SectionTitleStyle}"/>

                                <CheckBox x:Name="AutoRecognitionCheckBox"
                                          Content="LUMI 판매 아이템 자동 인식"
                                          Margin="0,17,0,0"
                                          IsChecked="True"
                                          Style="{StaticResource SwitchStyle}"
                                          Checked="GeneralSetting_Changed"
                                          Unchecked="GeneralSetting_Changed"/>

                                <Border Height="1" Margin="0,13" Background="#EEF0F3"/>

                                <CheckBox x:Name="AutoUpdateCheckBox"
                                          Content="새 버전 자동 확인"
                                          IsChecked="True"
                                          Style="{StaticResource SwitchStyle}"
                                          Checked="GeneralSetting_Changed"
                                          Unchecked="GeneralSetting_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="AboutPage"
                      Visibility="Collapsed"
                      Margin="30,26">
                    <StackPanel>
                        <TextBlock Text="정보" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="오늘의 루미 정보와 개발자 문의를 확인합니다."
                                   Style="{StaticResource PageSubtitleStyle}"/>

                        <Border Margin="0,22,0,0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="44"
                                        Height="44"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="11">
                                    <TextBlock Text="L"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="오늘의 루미"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="이터널 리턴의 LUMI 판매 아이템을 간편하게 확인할 수 있는 오버레이 프로그램입니다."
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"/>
                                    <Border Margin="0,13,0,0"
                                            Padding="9,4"
                                            HorizontalAlignment="Left"
                                            Background="#F2F4F7"
                                            CornerRadius="5">
                                        <TextBlock Text="비공식 프로그램"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="개발자 문의"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Discord · sinseol"
                                               Margin="0,10,0,0"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="아이디 복사"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="CopyDiscordButton_Click"/>
                                        <TextBlock x:Name="CopyStatusText"
                                                   Margin="9,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SuccessBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="버전"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock x:Name="AboutVersionText"
                                               Text="1.0.0"
                                               Margin="0,10,0,0"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Today's LUMI"
                                               Margin="0,5,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
