<Window x:Class="TodaysLUMI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="오늘의 루미"
        Width="700"
        Height="440"
        MinWidth="700"
        MinHeight="440"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#DCE1E7"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <TextBlock Text="오늘의 루미"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText"
                           Text="1.0.0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#7B8490"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="142"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#252A31"
                    BorderThickness="0,0,1,0"
                    Background="#FFFFFF">
                <StackPanel Margin="12,16">
                    <Button x:Name="HomeNavButton" Content="홈" Style="{StaticResource NavButtonStyle}" Click="HomeNavButton_Click"/>
                    <Button x:Name="OverlayNavButton" Content="오버레이" Style="{StaticResource NavButtonStyle}" Click="OverlayNavButton_Click"/>
                    <Button x:Name="SettingsNavButton" Content="설정" Style="{StaticResource NavButtonStyle}" Click="SettingsNavButton_Click"/>
                    <Button x:Name="AboutNavButton" Content="정보" Style="{StaticResource NavButtonStyle}" Click="AboutNavButton_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="HomePage" Margin="34,30">
                    <StackPanel>
                        <TextBlock Text="상태" FontSize="20" FontWeight="SemiBold"/>
                        <Border Margin="0,22,0,0" Padding="18" Background="#FFFFFF" BorderBrush="#DCE1E7" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="이터널 리턴" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="GameStatusText"
                                               Text="게임을 기다리는 중"
                                               Margin="0,5,0,0"
                                               Foreground="#66707C"
                                               FontSize="12"/>
                                </StackPanel>
                                <Ellipse x:Name="GameStatusDot"
                                         Grid.Column="1"
                                         Width="8"
                                         Height="8"
                                         Fill="#5E646D"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0" Padding="18" Background="#FFFFFF" BorderBrush="#DCE1E7" BorderThickness="1" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="이번 게임" Foreground="#66707C" FontSize="12"/>
                                <TextBlock x:Name="CurrentItemText"
                                           Text="아직 감지되지 않음"
                                           Margin="0,5,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="오버레이 테스트"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OverlayTestButton_Click"/>
                            <Button Content="다시 인식"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="RecognizeNowButton_Click"
                                    ToolTip="LUMI 판매 안내를 다시 찾습니다."/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid x:Name="OverlayPage" Visibility="Collapsed" Margin="34,30">
                    <StackPanel>
                        <TextBlock Text="오버레이" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="게임 화면에 표시되는 카드의 크기와 표시 방식을 설정합니다."
                                   Margin="0,7,0,18" Foreground="#66707C"/>

                        <CheckBox x:Name="OverlayEnabledCheckBox"
                                  Content="오버레이 표시"
                                  IsChecked="True"
                                  Checked="OverlaySetting_Changed"
                                  Unchecked="OverlaySetting_Changed"/>

                        <CheckBox x:Name="CompactOverlayCheckBox"
                                  Content="컴팩트 표시"
                                  Margin="0,12,0,0"
                                  Checked="OverlaySetting_Changed"
                                  Unchecked="OverlaySetting_Changed"/>

                        <CheckBox x:Name="GameActiveOnlyCheckBox"
                                  Content="게임이 활성화되어 있을 때만 표시"
                                  Margin="0,12,0,0"
                                  IsChecked="True"
                                  Checked="OverlaySetting_Changed"
                                  Unchecked="OverlaySetting_Changed"/>

                        <TextBlock Text="테스트 아이템" Margin="0,24,0,8" Foreground="#66707C"/>
                        <ComboBox x:Name="TestItemComboBox"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="TestItemComboBox_SelectionChanged"/>

                        <Button Content="오버레이 테스트"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OverlayTestButton_Click"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="34,30">
                    <StackPanel>
                        <TextBlock Text="설정" FontSize="20" FontWeight="SemiBold"/>

                        <TextBlock Text="일반" Margin="0,22,0,10" Foreground="#66707C"/>
                        <CheckBox x:Name="CloseToTrayCheckBox"
                                  Content="창을 닫으면 트레이로 최소화"
                                  IsChecked="True"
                                  Checked="GeneralSetting_Changed"
                                  Unchecked="GeneralSetting_Changed"/>
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Content="Windows 시작 시 실행"
                                  Margin="0,10,0,0"
                                  Checked="GeneralSetting_Changed"
                                  Unchecked="GeneralSetting_Changed"/>

                        <TextBlock Text="인식" Margin="0,24,0,10" Foreground="#66707C"/>
                        <CheckBox x:Name="AutoRecognitionCheckBox"
                                  Content="자동 인식"
                                  IsChecked="True"
                                  Checked="GeneralSetting_Changed"
                                  Unchecked="GeneralSetting_Changed"/>

                        <TextBlock Text="업데이트" Margin="0,24,0,10" Foreground="#66707C"/>
                        <CheckBox x:Name="AutoUpdateCheckBox"
                                  Content="자동으로 업데이트 확인"
                                  IsChecked="True"
                                  Checked="GeneralSetting_Changed"
                                  Unchecked="GeneralSetting_Changed"/>
                        <TextBlock Text="자동 업데이트 연결은 릴리스 단계에서 활성화됩니다."
                                   Margin="0,8,0,0" Foreground="#7B8490" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="AboutPage" Visibility="Collapsed" Margin="34,30">
                    <StackPanel>
                        <TextBlock Text="오늘의 루미" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="이터널 리턴의 LUMI 판매 아이템을 간편하게 확인할 수 있는 오버레이 프로그램입니다."
                                   Width="430"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#66707C"/>

                        <TextBlock Text="오늘의 루미는 비공식 프로그램입니다."
                                   Margin="0,22,0,0"/>

                        <TextBlock Text="개발자 문의" Margin="0,26,0,5" Foreground="#66707C"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Discord · sinseol" VerticalAlignment="Center"/>
                            <Button Content="복사"
                                    Margin="10,0,0,0"
                                    Padding="10,4"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="CopyDiscordButton_Click"/>
                            <TextBlock x:Name="CopyStatusText"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#6F957E"/>
                        </StackPanel>

                        <TextBlock Text="버전" Margin="0,26,0,5" Foreground="#66707C"/>
                        <TextBlock x:Name="AboutVersionText" Text="1.0.0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
